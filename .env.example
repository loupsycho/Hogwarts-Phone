# Neon PostgreSQL pooled connection string (keep the real value private)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/hogwarts_phone?sslmode=require

# Public app URL used to validate Clerk sessions
APP_URL=https://hogwarts-phone.vercel.app

# Clerk: publishable key is public; secret key is server-only.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_from_clerk
CLERK_SECRET_KEY=sk_test_or_sk_live_from_clerk

# Legacy Better Auth / Discord variables kept temporarily for rollback.
# Do not remove the existing Vercel values until Clerk production login is verified.
BETTER_AUTH_SECRET=legacy_better_auth_secret
BETTER_AUTH_URL=https://hogwarts-phone.vercel.app
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
