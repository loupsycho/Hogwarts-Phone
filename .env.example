# Neon PostgreSQL pooled connection string (keep the real value private)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/hogwarts_phone?sslmode=require

# Generate a unique secret with: npx auth secret
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Discord OAuth2 credentials from the existing Hogwarts Phone Discord application
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret
